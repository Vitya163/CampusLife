<Txt>:
    color: 0.10, 0.10, 0.16, 1
    halign: 'left'
    valign: 'middle'
    text_size: self.size

<Sec>:
    font_size: '12sp'
    bold: True
    color: 0.55, 0.55, 0.66, 1
    size_hint_y: None
    height: dp(28)

<RBtn>:
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    bold: True
    opacity: 0.85 if self.state == 'down' else 1
    canvas.before:
        Color:
            rgba: self.bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: self.radius

<Chip>:
    size_hint: None, None
    size: self.texture_size[0] + dp(30), dp(36)
    font_size: '14sp'
    radius: [dp(18)]
    bg: app.accent if self.active else (1, 1, 1, 1)
    color: (1, 1, 1, 1) if self.active else (0.35, 0.35, 0.46, 1)

<Panel>:
    canvas.before:
        Color:
            rgba: 0.2, 0.2, 0.45, 0.06
        RoundedRectangle:
            pos: self.x - dp(1), self.y - dp(4)
            size: self.width + dp(2), self.height + dp(1)
            radius: [dp(22)]
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(20)]

<Card>:
    opacity: 0.94 if self.state == 'down' else 1

<InfoTile>:
    orientation: 'vertical'
    padding: dp(16), dp(10)
    spacing: dp(2)
    Txt:
        text: root.caption
        font_size: '11sp'
        bold: True
        color: 0.55, 0.55, 0.66, 1
        size_hint_y: None
        height: dp(16)
    Txt:
        text: root.value
        font_size: '16sp'
        bold: True
        shorten: True
        shorten_from: 'right'

<Pill>:
    color: 0.10, 0.10, 0.16, 1
    size_hint: None, None
    size: self.texture_size[0] + dp(24), dp(28)
    font_size: '12sp'
    bold: True
    canvas.before:
        Color:
            rgba: self.bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2.0]

<Badge>:
    orientation: 'vertical'
    size_hint: None, None
    size: dp(50), dp(56)
    padding: 0, dp(6), 0, dp(4)
    canvas.before:
        Color:
            rgba: 1, 1, 1, 0.96
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(15)]
    Txt:
        text: root.day
        font_size: '20sp'
        bold: True
        halign: 'center'
    Txt:
        text: root.month
        font_size: '10sp'
        bold: True
        halign: 'center'
        color: app.accent

<Banner>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            texture: self.tex
            radius: self.radii
        Color:
            rgba: 1, 1, 1, (0.14 if self.deco else 0)
        Ellipse:
            pos: self.right - self.height * 1.05, self.y + self.height * 0.1
            size: self.height * 0.8, self.height * 0.8
        Color:
            rgba: 1, 1, 1, (0.10 if self.deco else 0)
        Ellipse:
            pos: self.x + self.width * 0.45, self.y + self.height * 0.55
            size: self.height * 0.36, self.height * 0.36

<NavBar>:
    size_hint_y: None
    height: dp(72)
    padding: dp(10), 0
    canvas.before:
        Color:
            rgba: 0.2, 0.2, 0.45, 0.08
        RoundedRectangle:
            pos: self.x, self.y + dp(2)
            size: self.width, self.height + dp(4)
            radius: [dp(26), dp(26), 0, 0]
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(24), dp(24), 0, 0]

<NavTab>:
    orientation: 'vertical'
    padding: 0, dp(10), 0, dp(6)
    spacing: dp(3)
    Icon:
        kind: root.kind
        col: app.accent if root.active else (0.62, 0.62, 0.70, 1)
        size_hint: None, None
        size: dp(24), dp(24)
        pos_hint: {'center_x': 0.5}
    Label:
        text: root.text
        font_size: '11sp'
        bold: root.active
        color: app.accent if root.active else (0.55, 0.55, 0.65, 1)
        size_hint_y: None
        height: dp(16)

<BackBtn>:
    size_hint: None, None
    size: dp(42), dp(42)
    padding: dp(12)
    canvas.before:
        Color:
            rgba: 1, 1, 1, 0.25
        Ellipse:
            pos: self.pos
            size: self.size
    Icon:
        kind: 'back'
        col: 1, 1, 1, 1

<HeadBtn>:
    size_hint: None, None
    size: dp(42), dp(42)
    canvas.before:
        Color:
            rgba: 1, 1, 1, 0.25
        Ellipse:
            pos: self.pos
            size: self.size
    Icon:
        kind: root.kind
        col: 1, 1, 1, 1
        size_hint: None, None
        size: dp(22), dp(22)
        pos: root.center_x - dp(11), root.center_y - dp(11)
    Label:
        text: str(root.badge) if root.badge < 100 else '99+'
        opacity: 1 if root.badge > 0 else 0
        size_hint: None, None
        size: dp(18), dp(18)
        pos: root.right - dp(14), root.top - dp(14)
        font_size: '10sp'
        bold: True
        color: 1, 1, 1, 1
        canvas.before:
            Color:
                rgba: 0.92, 0.25, 0.30, 1
            Ellipse:
                pos: self.pos
                size: self.size

<StyledInput>:
    size_hint_y: None
    height: dp(50)
    multiline: False
    background_normal: ''
    background_active: ''
    background_color: 0, 0, 0, 0
    foreground_color: 0.10, 0.10, 0.16, 1
    hint_text_color: 0.62, 0.62, 0.72, 1
    cursor_color: app.accent
    padding: dp(16), dp(15), dp(16), dp(10)
    font_size: '16sp'
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: (0.36, 0.30, 0.95, 1) if self.focus else (0.89, 0.89, 0.94, 1)
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(16)
            width: dp(1.3)

<Toggle>:
    canvas:
        Color:
            rgba: (0.36, 0.30, 0.95, 1) if self.active else (0.80, 0.80, 0.87, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2.0]
        Color:
            rgba: 1, 1, 1, 1
        Ellipse:
            pos: self.x + dp(3) + (self.width - self.height) * self.k, self.y + dp(3)
            size: self.height - dp(6), self.height - dp(6)

<SettingRow>:
    size_hint_y: None
    height: dp(52)
    padding: dp(18), 0
    Txt:
        text: root.text
        font_size: '15sp'
    Toggle:
        id: tg
        size_hint: None, None
        size: dp(50), dp(30)
        pos_hint: {'center_y': 0.5}
        on_active: app.set_opt(root.key, self.active)

<NotifItem>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: dp(16)
    spacing: dp(4)
    BoxLayout:
        size_hint_y: None
        height: dp(24)
        Txt:
            text: root.title
            font_size: '16sp'
            bold: True
            color: app.accent if root.unread else (0.10, 0.10, 0.16, 1)
        Txt:
            text: root.when
            size_hint_x: None
            width: dp(100)
            halign: 'right'
            font_size: '12sp'
            color: 0.55, 0.55, 0.66, 1
    Txt:
        text: root.text
        font_size: '14sp'
        color: 0.35, 0.35, 0.46, 1
        size_hint_y: None
        text_size: self.width, None
        height: self.texture_size[1]

<Toast>:
    orientation: 'vertical'
    padding: dp(16), dp(10)
    Txt:
        text: root.title
        bold: True
        font_size: '15sp'
        size_hint_y: None
        height: dp(22) if root.title else 0
        opacity: 1 if root.title else 0
        color: app.accent
    Txt:
        text: root.text
        font_size: '14sp'
        color: 0.25, 0.25, 0.36, 1
        max_lines: 2

<EmptyState>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(250)
    spacing: dp(16)
    padding: 0, dp(40), 0, 0
    Icon:
        kind: root.kind
        col: 0.70, 0.68, 0.95, 1
        size_hint: None, None
        size: dp(88), dp(88)
        pos_hint: {'center_x': 0.5}
    Txt:
        text: root.text
        halign: 'center'
        font_size: '15sp'
        color: 0.55, 0.55, 0.66, 1
