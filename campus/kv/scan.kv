<ScanScreen>:
    name: 'scan'
    BoxLayout:
        orientation: 'vertical'
        Banner:
            tex: app.grad_header
            radii: [0, 0, dp(30), dp(30)]
            size_hint_y: None
            height: dp(120)
            padding: dp(16), dp(30), dp(20), dp(16)
            spacing: dp(14)
            BackBtn:
                pos_hint: {'center_y': 0.5}
                on_release: app.go('feed', 'right')
            BoxLayout:
                orientation: 'vertical'
                Txt:
                    text: 'Сканер QR'
                    color: 1, 1, 1, 1
                    bold: True
                    font_size: '22sp'
                Txt:
                    text: 'Запись на событие и проверка билетов'
                    color: 1, 1, 1, 0.85
                    font_size: '13sp'
        FloatLayout:
            id: cam_box
            canvas.before:
                Color:
                    rgba: 0.08, 0.08, 0.12, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            canvas.after:
                Color:
                    rgba: 1, 1, 1, 0.9
                Line:
                    rounded_rectangle: self.center_x - min(self.width, self.height) * 0.36, self.center_y - min(self.width, self.height) * 0.36, min(self.width, self.height) * 0.72, min(self.width, self.height) * 0.72, dp(24)
                    width: dp(2)
        Txt:
            id: result
            text: ''
            halign: 'center'
            font_size: '15sp'
            bold: True
            size_hint_y: None
            height: dp(64)
            padding: dp(16), 0
        BoxLayout:
            size_hint_y: None
            height: dp(74)
            padding: dp(20), dp(10), dp(20), dp(14)
            spacing: dp(10)
            StyledInput:
                id: manual
                hint_text: 'Или вставьте код вручную'
                font_size: '14sp'
            RBtn:
                text: 'OK'
                size_hint_x: None
                width: dp(70)
                on_release: root.handle(root.ids.manual.text)
