<DetailScreen>:
    name: 'detail'
    BoxLayout:
        orientation: 'vertical'
        Banner:
            orientation: 'vertical'
            tex: root.hero_tex
            deco: root.hero_deco
            radii: [0, 0, dp(30), dp(30)]
            size_hint_y: None
            height: dp(236)
            padding: dp(16), dp(30), dp(16), dp(18)
            spacing: dp(8)
            BoxLayout:
                size_hint_y: None
                height: dp(42)
                BackBtn:
                    on_release: app.go('feed', 'right')
                Widget:
            Widget:
            Pill:
                id: cat_pill
                bg: 1, 1, 1, 0.94
            Txt:
                id: title
                color: 1, 1, 1, 1
                font_size: '24sp'
                bold: True
                max_lines: 2
                size_hint_y: None
                height: dp(66)
        ScrollView:
            id: scroll
            bar_width: 0
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20), dp(18), dp(20), dp(24)
                spacing: dp(14)
                BoxLayout:
                    size_hint_y: None
                    height: dp(68)
                    spacing: dp(12)
                    InfoTile:
                        id: t_date
                        caption: 'ДАТА'
                    InfoTile:
                        id: t_time
                        caption: 'ВРЕМЯ'
                InfoTile:
                    id: t_place
                    caption: 'МЕСТО'
                    size_hint_y: None
                    height: dp(68)
                BoxLayout:
                    size_hint_y: None
                    height: dp(68)
                    spacing: dp(12)
                    InfoTile:
                        id: t_count
                        caption: 'ЗАПИСАЛИСЬ'
                    InfoTile:
                        id: t_reg
                        caption: 'НАБОР'
                Txt:
                    text: 'О мероприятии'
                    font_size: '18sp'
                    bold: True
                    size_hint_y: None
                    height: dp(30)
                Txt:
                    id: info
                    font_size: '15sp'
                    color: 0.35, 0.35, 0.46, 1
                    size_hint_y: None
                    text_size: self.width, None
                    height: self.texture_size[1]
                Txt:
                    text: 'Напоминание'
                    font_size: '18sp'
                    bold: True
                    size_hint_y: None
                    height: dp(30)
                ScrollView:
                    size_hint_y: None
                    height: dp(46)
                    do_scroll_y: False
                    bar_width: 0
                    BoxLayout:
                        id: rem_row
                        size_hint_x: None
                        width: self.minimum_width
                        padding: 0, dp(5)
                        spacing: dp(8)
        NavBar:
            height: dp(84)
            padding: dp(20), dp(16)
            spacing: dp(10)
            RBtn:
                id: fav
                size_hint_x: 0.32
                font_size: '13sp'
                on_release: root.toggle_fav()
            RBtn:
                text: 'QR'
                size_hint_x: 0.18
                bg: 0.93, 0.93, 0.96, 1
                color: app.accent
                on_release: app.open_qr(root.ev)
            RBtn:
                id: signup
                size_hint_x: 0.5
                on_release: root.toggle_signup()
