<CreateScreen>:
    name: 'create'
    BoxLayout:
        orientation: 'vertical'
        Banner:
            tex: app.grad_header
            radii: [0, 0, dp(30), dp(30)]
            size_hint_y: None
            height: dp(120)
            padding: dp(16), dp(30), dp(20), dp(16)
            spacing: dp(14)
            BackBtn:
                pos_hint: {'center_y': 0.5}
                on_release: app.go('feed', 'right')
            BoxLayout:
                orientation: 'vertical'
                Txt:
                    text: 'Новое событие'
                    color: 1, 1, 1, 1
                    bold: True
                    font_size: '22sp'
                Txt:
                    text: 'Для организаторов'
                    color: 1, 1, 1, 0.85
                    font_size: '13sp'
        ScrollView:
            bar_width: 0
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20), dp(18), dp(20), dp(10)
                spacing: dp(12)
                StyledInput:
                    id: title
                    hint_text: 'Название мероприятия'
                StyledInput:
                    id: desc
                    hint_text: 'Описание'
                    multiline: True
                    height: dp(110)
                StyledInput:
                    id: place
                    hint_text: 'Место проведения'
                BoxLayout:
                    size_hint_y: None
                    height: dp(50)
                    spacing: dp(12)
                    StyledInput:
                        id: dt
                        hint_text: 'ГГГГ-ММ-ДД'
                    StyledInput:
                        id: tm
                        hint_text: 'ЧЧ:ММ'
                StyledInput:
                    id: cap
                    hint_text: 'Количество мест (пусто — без лимита)'
                    input_filter: 'int'
                StyledInput:
                    id: ro
                    hint_text: 'Начало набора ГГГГ-ММ-ДД (пусто — сразу)'
                Txt:
                    text: 'Категория'
                    font_size: '16sp'
                    bold: True
                    size_hint_y: None
                    height: dp(28)
                ScrollView:
                    size_hint_y: None
                    height: dp(46)
                    do_scroll_y: False
                    bar_width: 0
                    BoxLayout:
                        id: cat_row
                        size_hint_x: None
                        width: self.minimum_width
                        padding: 0, dp(5)
                        spacing: dp(8)
                Txt:
                    id: msg
                    color: 0.88, 0.25, 0.30, 1
                    font_size: '14sp'
                    size_hint_y: None
                    height: dp(24)
        BoxLayout:
            size_hint_y: None
            height: dp(84)
            padding: dp(20), dp(12), dp(20), dp(14)
            RBtn:
                text: 'Опубликовать'
                font_size: '17sp'
                on_release: root.save()
